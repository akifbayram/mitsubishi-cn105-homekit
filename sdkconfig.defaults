CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_HTTPD_WS_SUPPORT=y
CONFIG_HAP_HTTP_SERVER_PORT=8080
CONFIG_LWIP_MAX_SOCKETS=16
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=11440
CONFIG_LWIP_TCP_WND_DEFAULT=11440
CONFIG_LWIP_TCP_RECVMBOX_SIZE=12
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=n
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_MAX_BONDS=1
CONFIG_LOG_MAXIMUM_LEVEL_DEBUG=y
CONFIG_LOG_MAXIMUM_LEVEL=4
CONFIG_ESP_TASK_WDT_EN=y
CONFIG_ESP_TASK_WDT_INIT=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=10
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU0=y
CONFIG_ESP_TASK_WDT_PANIC=y
CONFIG_COMPILER_STACK_CHECK_MODE_STRONG=y
CONFIG_FREERTOS_WATCHPOINT_END_OF_STACK=y
CONFIG_HEAP_CORRUPTION_DETECTION_LIGHT=y
# -O2 instead of the -Og default: faster CPU-bound code (and smaller here).
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_COMPILER_OPTIMIZATION_ASSERTIONS_SILENT=y
CONFIG_BOOTLOADER_LOG_LEVEL_WARN=y

# Serin Link v2 pairing (libsodium Ed25519/X25519) runs on the main task via
# espnowLink.loop(); the 3.5KB IDF default overflows (debug-exception panic).
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384

# Any task that logs runs vsnprintf in the log hook on its own stack — worst
# case ~1.5KB, marginal on the IDF-default small stacks. The FreeRTOS timer
# task (2048; a closed-blob WiFi timer logs there) panicked with a stack
# canary during DEBUG-level soak testing; the event task (2304) logs on every
# WiFi/HomeKit event and is the same class.
#
# 2026-07-13: a WiFi/coex blob timer callback overflowed the 4096 depth too,
# reproducibly at ~600s uptime (Tmr Svc stack-canary panic) on a WiFi+BLE-coex
# AtomS3 Lite — the 10-min period matches a router GTK rekey, whose EAPOL
# group handshake runs in that closed blob and can't be shrunk. Raised to 8192.
CONFIG_FREERTOS_TIMER_TASK_STACK_DEPTH=8192
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
